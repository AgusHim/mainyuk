# App config
BASE_URL=
BASE_API=
AUTH_SECRET=
WEBSOCKET_HOST=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Public peserta page: /peserta
# Copy URL dari baris pertama curl-update-peserta.md:
# curl 'https://dashboard.darisini.com/api/graphql'
DASHBOARD_DARISINI_GRAPHQL_URL=https://dashboard.darisini.com/api/graphql

# Copy event ID dari Referer atau variables._eventId di curl-update-peserta.md:
# Referer: https://dashboard.darisini.com/events/<EVENT_ID>/participants
# variables: {"_eventId":"<EVENT_ID>"}
DASHBOARD_DARISINI_EVENT_ID=cmrlrzyya0dzcs6019lsr8r81

# Copy semua isi header Cookie dari curl-update-peserta.md.
# Ambil nilai setelah:
# -H 'Cookie: ...'
# Jangan sertakan "-H 'Cookie:" dan jangan sertakan tanda kutip penutup.
DASHBOARD_DARISINI_COOKIE=
